---
# Clang-tidy configuration for node-sqlite
# Focus on C++ best practices and common issues
#
# WARNING: `Checks:` below is a single quoted YAML scalar. A "#" inside it is NOT
# a comment -- it becomes literal check-pattern text and silently swallows the
# next entry (a "# ..." line before `-cppcoreguidelines-owning-memory` re-enabled
# that check). Keep all commentary out here, above the scalar.
#
# Notes on the disabled entries:
#   -cppcoreguidelines-owning-memory: demands gsl::owner<> annotations and we do
#     not depend on GSL. Ownership is expressed with RAII guards + ObjectWrap.

Checks: '
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  cert-*,
  -cert-err58-cpp,
  clang-analyzer-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  google-*,
  -google-build-using-namespace,
  -google-readability-casting,
  -google-runtime-references,
  hicpp-*,
  -hicpp-signed-bitwise,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  performance-*,
  readability-*,
  -readability-else-after-return,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-function-cognitive-complexity,
  -readability-identifier-length
'

# Gate CI on the high-signal ownership/lifetime checks only.
#
# These are the ones that actually protect an addon: raw owning pointers
# (sqlite3*, sqlite3_stmt*), hand-written move guards, and the ObjectWrap
# subclasses whose destruction order is the usual source of use-after-free.
# Everything else (style, readability, modernize) stays advisory so it reports
# without blocking -- an empty WarningsAsErrors made ALL of it advisory, which
# meant clang-tidy could never fail a build.
WarningsAsErrors: 'bugprone-use-after-move,bugprone-dangling-handle,bugprone-unchecked-optional-access,clang-analyzer-cplusplus.NewDelete,clang-analyzer-cplusplus.NewDeleteLeaks,clang-analyzer-unix.Malloc,cppcoreguidelines-special-member-functions,hicpp-special-member-functions'

# Header filter - only check our headers, not system/node headers
HeaderFilterRegex: '^((?!node_modules|vendored|upstream|shims).)*\.(h|hpp)$'

# Format style
FormatStyle: google

# Check options
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MemberCase
    value: lower_case_
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: false
  - key: modernize-use-override.IgnoreDestructors
    value: true