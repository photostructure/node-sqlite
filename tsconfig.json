{
  "#": "used by `npm run watch` and vscode. Note that this doesn't emit anything into ./dist/",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "types": ["node", "jest"],
    "paths": {
      "@photostructure/sqlite": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": [
    "dist",
    "coverage",
    "docs",
    "benchmark",
    "test/stress-test.test.ts",
    "test/api-compatibility.test.ts"
  ]
}
