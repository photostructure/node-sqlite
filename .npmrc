# Security hardening: Disable lifecycle scripts by default to prevent supply chain attacks
# This protects against malicious postinstall/preinstall scripts in dependencies
#
# For local development, run: npm install --ignore-scripts=false
# Then build native code: npm run build:native
ignore-scripts=true

# Delay newly published dependencies long enough for ecosystem review.
# Keep in step with .ncurc.cjs (cooldown), .pinact.yaml (min_age), and
# scripts/release-cli.ts (--min-release-age).
min-release-age=12
