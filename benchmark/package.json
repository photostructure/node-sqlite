{
  "name": "@photostructure/sqlite-benchmark",
  "version": "1.0.0",
  "private": true,
  "// type": "do not mark this as an ESM package -- this library is intended to run in both CJS and ESM modes",
  "description": "Performance benchmarks for @photostructure/sqlite compared to other SQLite libraries",
  "scripts": {
    "prebench": "tsc --noEmit",
    "bench": "tsx index.ts",
    "bench:select": "tsx index.ts select",
    "bench:insert": "tsx index.ts insert",
    "bench:transaction": "tsx index.ts transaction",
    "bench:memory": "tsx --expose-gc memory-benchmark.ts",
    "bench:tagstore": "tsx tagstore-benchmark.ts"
  },
  "dependencies": {
    "@photostructure/sqlite": "file:..",
    "better-sqlite3": "^12.5.0",
    "chalk": "^5.6.2",
    "deasync": "^0.1.31",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/deasync": "^0.1.5",
    "@types/node": "^24.10.1",
    "tsx": "4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
