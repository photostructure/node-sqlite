{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["*.ts"],
  "exclude": [
    "../src/**/*",
    "../test/**/*",
    "../benchmark/**/*",
    "../node_modules/**/*",
    "stress-test.ts"
  ]
}
